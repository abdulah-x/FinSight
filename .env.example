GROQ_API_KEY=your-groq-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Postgres (predictions for the Stage 7 eval) ----------
POSTGRES_PASSWORD=change-me
# used when running the backend outside Docker (cli.py, uvicorn from the venv)
DATABASE_URL=postgresql://finsight:change-me@127.0.0.1:5433/finsight

# ---------- API security (optional, these are the defaults) ----------
# comma-separated origins allowed to call the API from a browser
FRONTEND_ORIGIN=http://localhost:8080
# per-IP limit on /analyze and /resume
RATE_LIMIT=10/minute

# ---------- Forward test (Stage 7) ----------
# run the confidence engine on every asset each bar, to build the calibration sample
COLLECTOR_ENABLED=false
